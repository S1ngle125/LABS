#include <iostream>  //  .  .  .  .  ..  .  .  .  .  LAB06-B4
#include <vector>
#include <algorithm>
using namespace std;
int digit_sum(int n) {
    int sum = 0;
    while (n > 0) {
        sum += n % 10;
        n /= 10;
    }
    return sum;
}

int main() {
    int n;
    cout << "Введите размер: ";
    cin >> n;
    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }
    stable_sort(arr.begin(), arr.end(), [](int a, int b) {
        int sum_a = digit_sum(a);
        int sum_b = digit_sum(b);
        if (sum_a != sum_b) {
            return sum_a < sum_b;
        }
        return false;
    });
    for (int i = 0; i < n; i++) {
        cout << arr[i];
        if (i != n - 1) cout << " ";
    }
    cout << endl;
}
