bool check_sorted(const vector<int> &a, bool increasing) {
    for (size_t i = 1; i < a.size(); ++i) {
        if (increasing) {
            if (a[i] < a[i-1]) return false;
        } else {
            if (a[i] > a[i-1]) return false;
        }
    }
    return true;
}
void bubble_sort_alternative(vector<int> &arr) {
    int n = arr.size();
    for (int i = 0; i < n - 1; ++i) {
        for (int j = n - 1; j > i; --j) {
            if (arr[j] < arr[j-1]) {
                swap(arr[j], arr[j-1]);
            }
        }
    }
}
void insertion_sort_descending(vector<int> &arr) {
    int n = arr.size();
    for (int i = 1; i < n; ++i) {
        int key = arr[i];
        int j = i - 1;
        while (j >= 0 && arr[j] < key) {
            arr[j + 1] = arr[j];
            --j;
        }
        arr[j + 1] = key;
    }
}
