void test_sorting(const string &sort_name, 
                  void (*sort_func)(vector<int>&),
                  vector<vector<int>> sequences,
                  bool increasing_check) {
    cout << endl;                  
    cout << "===== " << sort_name << " =====";
    cout << endl;
    for (size_t idx = 0; idx < sequences.size(); ++idx) {
        vector<int> arr = sequences[idx];
        sort_func(arr);
        int size = arr.size();
        bool sorted = check_sorted(arr, increasing_check);
        cout << "Размер: " << size;
        cout << "  Сортировка: " << (sorted ? "OK" : "FAIL");
        if (size <= 20) {
            cout << " | Результат: ";
            for (int i = 0; i < min(10, size); ++i) cout << arr[i] << " ";
            if (size > 10) cout << "...";
        }
        cout << endl;
    }
}

int main() {
    generate_tests();
    vector<vector<int>> sequences = read_sequences("multitest_1.txt");
    if (sequences.empty()) {
        cerr << "Нет данных для тестирования.\n";
    }
    test_sorting("Альт Bubble Sort (неубывание, мин. влево)",
                 bubble_sort_alternative, sequences, true);
    test_sorting("Insertion Sort (невозрастание, убывание)",
                 insertion_sort_descending, sequences, false);
}


