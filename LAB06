using namespace std;
using namespace chrono;
bool check_sorted(const vector<int> &a, bool increasing) {
    for (size_t i = 1; i < a.size(); ++i) {
        if (increasing) {
            if (a[i] < a[i-1]) return false;
        } else {
            if (a[i] > a[i-1]) return false;
        }
    }
    return true;
}
class SortingChampion {
public:
    static void selection_sort(vector<int> &a) {
        int n = a.size();
        for (int i = 0; i < n-1; i++) {
            int min_idx = i;
            for (int j = i+1; j < n; j++)
                if (a[j] < a[min_idx]) min_idx = j;
            swap(a[i], a[min_idx]);
        }
    }
    static void bubble_sort(vector<int> &a) {
        int n = a.size();
        for (int i = 0; i < n-1; i++)
            for (int j = 0; j < n-i-1; j++)
                if (a[j] > a[j+1])
                    swap(a[j], a[j+1]);
    }
    static void insertion_sort(vector<int> &a) {
        int n = a.size();
        for (int i = 1; i < n; i++) {
            int key = a[i];
            int j = i-1;
            while (j >= 0 && a[j] > key) {
                a[j+1] = a[j];
                j--;
            }
            a[j+1] = key;
        }
    }
    static void merge_sort(vector<int> &a) {
        merge_sort_rec(a, 0, a.size()-1);
    }
    static void quick_sort(vector<int> &a) {
        quick_sort_rec(a, 0, a.size()-1);
    }
    static void randomized_quick_sort(vector<int> &a) {
        randomized_quick_sort_rec(a, 0, a.size()-1);
    }
private:
    static void merge_sort_rec(vector<int> &a, int l, int r) {
        if (l >= r) return;
        int m = (l + r) / 2;
        merge_sort_rec(a, l, m);
        merge_sort_rec(a, m+1, r);
        
        vector<int> temp(r-l+1);
        int i = l, j = m+1, k = 0;
        while (i <= m && j <= r)
            temp[k++] = (a[i] <= a[j]) ? a[i++] : a[j++];
        while (i <= m) temp[k++] = a[i++];
        while (j <= r) temp[k++] = a[j++];
        
        for (int p = 0; p < k; p++)
            a[l+p] = temp[p];
    }
    static void quick_sort_rec(vector<int> &a, int l, int r) {
        if (l >= r) return;
        int pivot = a[(l+r)/2];
        int i = l, j = r;
        while (i <= j) {
            while (a[i] < pivot) i++;
            while (a[j] > pivot) j--;
            if (i <= j) swap(a[i++], a[j--]);
        }
        quick_sort_rec(a, l, j);
        quick_sort_rec(a, i, r);
    }
    static void randomized_quick_sort_rec(vector<int> &a, int l, int r) {
        if (l >= r) return;
        static mt19937 gen(time(0));
        uniform_int_distribution<int> dist(l, r);
        int rand_idx = dist(gen);
        swap(a[rand_idx], a[(l+r)/2]);
        quick_sort_rec(a, l, r);
    }
};
vector<vector<int>> read_sequences(const string &filename) {
    vector<vector<int>> sequences;
    ifstream in(filename);
    if (!in.is_open()) {
        cerr << "не удалось открыть " << filename << endl;
        return sequences;
    }
    int size;
    while (in >> size) {
        vector<int> arr(size);
        for (int i = 0; i < size; ++i) {
            in >> arr[i];
        }
        sequences.push_back(arr);
    }
    return sequences;
}
void write_report(const string &filename, const vector<pair<string, vector<long long>>> &results,
                  const vector<int> &sizes) {
    ofstream out(filename);
    out << "Алгоритм";
    for (int s : sizes) out << "\t" << s;
    out << endl;
    
    for (const auto &algo : results) {
        out << algo.first;
        for (long long t : algo.second) out << "\t" << t;
        out << endl;
    }
    out.close();
}
int main() {
    vector<vector<int>> small = read_sequences("multitest_1.txt");
    vector<vector<int>> large = read_sequences("multitest_2.txt");
    if (small.empty() || large.empty()) {
        cerr << "ошибка: файлы multitest_1.txt или multitest_2.txt не найдены" << endl;
    }
    
    vector<int> sizes_small = {10, 100, 1000, 5000, 10000};
    vector<int> sizes_large = {100000, 500000, 1000000, 5000000, 10000000};
    vector<pair<string, void(*)(vector<int>&)>> algos1 = {
        {"Selection", SortingChampion::selection_sort},
        {"Bubble", SortingChampion::bubble_sort},
        {"Insertion", SortingChampion::insertion_sort},
        {"Merge", SortingChampion::merge_sort},
        {"Quick", SortingChampion::quick_sort},
        {"RandomizedQuick", SortingChampion::randomized_quick_sort}
    };
    vector<pair<string, void(*)(vector<int>&)>> algos2 = {
        {"Merge", SortingChampion::merge_sort},
        {"Quick", SortingChampion::quick_sort},
        {"RandomizedQuick", SortingChampion::randomized_quick_sort}
    };
    vector<pair<string, vector<long long>>> results1;
    for (auto &algo : algos1) {
        vector<long long> times;
        for (size_t i = 0; i < small.size(); i++) {
            vector<int> copy = small[i];
            auto start = high_resolution_clock::now();
            algo.second(copy);
            auto end = high_resolution_clock::now();
            times.push_back(duration_cast<microseconds>(end - start).count());
            if (!check_sorted(copy, true))
                cout << "Ошибка в " << algo.first << " на размере " << sizes_small[i] << "\n";
        }
        results1.push_back({algo.first, times});
    }
    write_report("report_1.txt", results1, sizes_small);
    vector<pair<string, vector<long long>>> results2;
    for (auto &algo : algos2) {
        vector<long long> times;
        for (size_t i = 0; i < large.size(); i++) {
            vector<int> copy = large[i];
            auto start = high_resolution_clock::now();
            algo.second(copy);
            auto end = high_resolution_clock::now();
            times.push_back(duration_cast<milliseconds>(end - start).count()); // в миллисекундах
            if (!check_sorted(copy, true))
                cout << "Ошибка в " << algo.first << " на размере " << sizes_large[i] << "\n";
        }
        results2.push_back({algo.first, times});
    }
    write_report("report_2.txt", results2, sizes_large);
    cout << "Отчёты сохранены в: report_1.txt, report_2.txt" << endl;
}


